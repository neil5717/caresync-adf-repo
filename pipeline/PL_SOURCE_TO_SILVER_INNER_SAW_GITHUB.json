{
	"name": "PL_SOURCE_TO_SILVER_INNER_SAW_GITHUB",
	"properties": {
		"activities": [
			{
				"name": "Read Table Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from dbo.table_config where table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_FabricSQL_ProcessDB",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Set Start Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check Load Type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read Table Details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Start Time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Table Details').output.firstRow.load_type,'FULL' ))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Read Watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select watermark_value from dbo.watermark where table_id=@{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_FabricSQL_ProcessDB",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Store Watermark Value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Read Watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('Read Watermark').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Source To Landing Ingestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check Load Type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_RestAPI",
						"type": "DatasetReference",
						"parameters": {
							"p_relative_url": {
								"value": "@activity('Read Table Details').output.firstRow.source_relative_url",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_JSON",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    activity('Read Table Details').output.firstRow.source_system,\n    '/',\n    activity('Read Table Details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Landing to Bronze",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Source To Landing Ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "https://api.fabric.microsoft.com/v1/workspaces/5aa0e28e-ab58-4dd7-91b4-0b577536312a/notebooks/3377da5b-cb41-4b90-baa6-e3e657ededa1/jobs/execute/instances?beta=false",
						"type": "Expression"
					},
					"body": {
						"value": "@json(concat(\n'{\"executionData\":{\"compute\":\"Spark\"},\"parameters\":[\n{\"name\":\"p_source_path\",\"value\":\"',\nconcat(\n    'Files/landing/GitHub/',\n    activity('Read Table Details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n),\n'\",\"type\":\"Text\"},\n{\"name\":\"p_target_table\",\"value\":\"',\nactivity('Read Table Details').output.firstRow.silver_table_name,\n'\",\"type\":\"Text\"},\n{\"name\":\"p_load_type\",\"value\":\"',\nactivity('Read Table Details').output.firstRow.load_type,\n'\",\"type\":\"Text\"},\n{\"name\":\"p_landing_timestamp\",\"value\":\"',\nvariables('start_time'),\n'\",\"type\":\"Text\"},\n{\"name\":\"p_source_file_format\",\"value\":\"',\nactivity('Read Table Details').output.firstRow.source_file_format,\n'\",\"type\":\"Text\"}\n]}'\n))\n",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://api.fabric.microsoft.com"
					}
				}
			},
			{
				"name": "Bronze to Silver",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Landing to Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "https://api.fabric.microsoft.com/v1/workspaces/5aa0e28e-ab58-4dd7-91b4-0b577536312a/notebooks/05d8c62e-1da9-452f-853d-89706bfdb1e9/jobs/execute/instances?beta=false",
						"type": "Expression"
					},
					"body": {
						"value": "\n@json(concat(\n'{\"executionData\":{\"compute\":\"Spark\"},\"parameters\":[\n{\"name\":\"p_source_path\",\"value\":\"',\nconcat(\n    'Files/landing/GitHub/',\n    activity('Read Table Details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n),\n'\",\"type\":\"Text\"},\n{\"name\":\"p_target_table\",\"value\":\"',\nactivity('Read Table Details').output.firstRow.silver_table_name,\n'\",\"type\":\"Text\"},\n{\"name\":\"p_landing_timestamp\",\"value\":\"',\nvariables('start_time'),\n'\",\"type\":\"Text\"},\n{\"name\":\"p_load_type\",\"value\":\"',\nactivity('Read Table Details').output.firstRow.load_type,\n'\",\"type\":\"Text\"},\n{\"name\":\"p_merge_keys\",\"value\":\"',\nactivity('Read Table Details').output.firstRow.merge_keys,\n'\",\"type\":\"Text\"},\n{\"name\":\"p_source_file_format\",\"value\":\"',\nactivity('Read Table Details').output.firstRow.source_file_format,\n'\",\"type\":\"Text\"}\n]}'\n))\n",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://api.fabric.microsoft.com"
					}
				}
			},
			{
				"name": "Update Success Status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Get Silver Notebook Result",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_FabricSQL_ProcessDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE dbo.audit_log\nSET status = 'SUCCESS',\n    end_time = SYSUTCDATETIME(),\n    records_read=@{activity('Source To Landing Ingestion').output.rowsRead},\n    records_written = @{int(activity('Get Silver Notebook Result').output.properties.exitValue)}\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND table_id = @{pipeline().parameters.table_id};",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Get Silver Notebook Result",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Bronze to Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat(\n'https://api.fabric.microsoft.com/v1/workspaces/5aa0e28e-ab58-4dd7-91b4-0b577536312a/notebooks/05d8c62e-1da9-452f-853d-89706bfdb1e9/jobs/execute/instances',\nactivity('Bronze to Silver').output.id,\n'?beta=true'\n)",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://api.fabric.microsoft.com"
					}
				}
			},
			{
				"name": "Update Watermark Column_copy1",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.watermark \nset watermark_value = sysutcdatetime()\nwhere table_id=@{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Update Watermark Column",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Get Silver Notebook Result",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_FabricSQL_ProcessDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update dbo.watermark \nset watermark_value = sysutcdatetime()\nwhere table_id=@{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "6"
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"start_time": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			}
		},
		"folder": {
			"name": "SAW_GITHUB"
		},
		"annotations": []
	}
}