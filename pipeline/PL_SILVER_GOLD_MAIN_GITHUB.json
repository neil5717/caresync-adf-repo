{
	"name": "PL_SILVER_GOLD_MAIN_GITHUB",
	"properties": {
		"activities": [
			{
				"name": "Read Table From Source",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select table_id ,gold_table_name from dbo.table_config where is_active=1 and stage='SILVER_TO_GOLD' and table_type='@{pipeline().parameters.table_type}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_FabricSQL_ProcessDB",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Ingest All Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Getting All Notebooks IDs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read Table From Source').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute Gold Notebook",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "InSert In-Progress Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Execute_Gold_Notebook_GITHUB",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_gold_table_name": {
										"value": "@item().gold_table_name",
										"type": "Expression"
									},
									"p_notebooks": {
										"value": "@activity('Getting All Notebooks IDs').output.value",
										"type": "Expression"
									},
									"adf_run_id": {
										"value": "@pipeline().parameters.adf_run_id",
										"type": "Expression"
									},
									"table_id": {
										"value": "@item().table_id",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "InSert In-Progress Status",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_FabricSQL_ProcessDB",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "INSERT INTO dbo.audit_log (adf_run_id, table_id,status,stage,start_time)\nVALUES ('@{pipeline().parameters.adf_run_id}',@{item().table_id},'In_Progress','SILVER_TO_GOLD',sysutcdatetime())",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Update Fail Status",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Execute Gold Notebook",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_FabricSQL_ProcessDB",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE dbo.audit_log\nSET\n    status = 'FAILED',\n    end_time = SYSUTCDATETIME(),\n    error_message = 'Gold notebook pipeline execution failed'\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND table_id = @{item().table_id}\n  AND stage = 'SILVER_TO_GOLD';",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Fail Gold Notebook Pipeline",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Update Fail Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "Gold notebook execution failed",
								"errorCode": "GOLD_PIPELINE_FAILED"
							}
						}
					]
				}
			},
			{
				"name": "Getting All Notebooks IDs",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Read Table From Source",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "https://api.fabric.microsoft.com/v1/workspaces/5aa0e28e-ab58-4dd7-91b4-0b577536312a/notebooks",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://api.fabric.microsoft.com"
					}
				}
			},
			{
				"name": "Getting Notebooks ID Failed",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Update Notebook Discovery Failed Audit",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "Getting Notebooks ID Failed",
					"errorCode": "Getting Notebooks ID Failed"
				}
			},
			{
				"name": "Update Notebook Discovery Failed Audit",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Getting All Notebooks IDs",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_FabricSQL_ProcessDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "MERGE dbo.audit_log AS tgt\nUSING\n(\n    SELECT table_id\n    FROM dbo.table_config\n    WHERE is_active = 1\n      AND stage = 'SILVER_TO_GOLD'\n      AND table_type = '@{pipeline().parameters.table_type}'\n) AS src\nON  tgt.adf_run_id = '@{pipeline().parameters.adf_run_id}'\nAND tgt.table_id = src.table_id\nAND tgt.stage = 'SILVER_TO_GOLD'\n\nWHEN MATCHED THEN\n    UPDATE SET\n        status = 'FAILED',\n        end_time = SYSUTCDATETIME(),\n        error_message = 'Failed to retrieve Fabric notebook list'\n\nWHEN NOT MATCHED THEN\n    INSERT\n    (\n        adf_run_id,\n        table_id,\n        status,\n        stage,\n        start_time,\n        end_time,\n        error_message\n    )\n    VALUES\n    (\n        '@{pipeline().parameters.adf_run_id}',\n        src.table_id,\n        'FAILED',\n        'SILVER_TO_GOLD',\n        SYSUTCDATETIME(),\n        SYSUTCDATETIME(),\n        'Failed to retrieve Fabric notebook list'\n    );",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string"
			},
			"table_type": {
				"type": "string"
			}
		},
		"folder": {
			"name": "SAW_GITHUB"
		},
		"annotations": []
	}
}