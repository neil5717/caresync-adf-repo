{
	"name": "PL_Execute_Gold_Notebook_GITHUB",
	"properties": {
		"activities": [
			{
				"name": "Filter Notebook",
				"type": "Filter",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.p_notebooks",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(\n    toUpper(item().displayName),\n    toUpper(concat('NB_Gold_', pipeline().parameters.p_gold_table_name))\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Condition Notebook Exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Filter Notebook",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(length(activity('Filter Notebook').output.Value), 0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Update Gold Notebook Not Found Status",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_FabricSQL_ProcessDB",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE dbo.audit_log\nSET\n    status = 'FAILED',\n    end_time = SYSUTCDATETIME(),\n    error_message = 'Gold notebook not found in workspace'\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\n  AND table_id = @{pipeline().parameters.table_id};",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Fail Gold Notebook Not Found",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Update Gold Notebook Not Found Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "No matching Gold notebook found in the Fabric workspace.",
								"errorCode": "GOLD_NOTEBOOK_NOT_FOUND"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Execute Gold Notebook Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Run_Gold_Notebook",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_gold_table_name": {
										"value": "@pipeline().parameters.p_gold_table_name",
										"type": "Expression"
									},
									"adf_run_id": {
										"value": "@pipeline().parameters.adf_run_id",
										"type": "Expression"
									},
									"table_id": {
										"value": "@pipeline().parameters.table_id",
										"type": "Expression"
									},
									"p_notebook_id": {
										"value": "@activity('Filter Notebook').output.Value[0].id",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_gold_table_name": {
				"type": "string"
			},
			"p_notebooks": {
				"type": "array"
			},
			"adf_run_id": {
				"type": "string"
			},
			"table_id": {
				"type": "string"
			}
		},
		"variables": {
			"v_job_status_url": {
				"type": "String"
			}
		},
		"folder": {
			"name": "SAW_GITHUB"
		},
		"annotations": []
	}
}