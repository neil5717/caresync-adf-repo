		{
			"name": "[concat(parameters('factoryName'), '/LS_FabricSQL_ProcessDB')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_FabricSQL_ProcessDB_properties_typeProperties_server')]",
					"database": "[parameters('LS_FabricSQL_ProcessDB_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "ServicePrincipal",
					"servicePrincipalId": "[parameters('LS_FabricSQL_ProcessDB_properties_typeProperties_servicePrincipalId')]",
					"servicePrincipalCredential": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "LS_KeyVoult",
							"type": "LinkedServiceReference"
